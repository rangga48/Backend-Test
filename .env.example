# Server Configuration
PORT=8080
ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=geospatial_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Optional direct connection string (uncomment to use)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/geospatial_db?sslmode=disable

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
